{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/(assets/.*|styles.css|app.js|.*\\.(?:css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|webp))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}